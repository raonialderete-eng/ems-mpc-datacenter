	component nios_system is
		port (
			clk_0_clk                          : in  std_logic                     := 'X';             -- clk
			pio_hex_external_connection_export : out std_logic_vector(13 downto 0);                    -- export
			pio_key_external_connection_export : in  std_logic_vector(3 downto 0)  := (others => 'X'); -- export
			pio_led_external_connection_export : out std_logic_vector(17 downto 0);                    -- export
			pio_sw_external_connection_export  : in  std_logic_vector(17 downto 0) := (others => 'X'); -- export
			reset_reset_n                      : in  std_logic                     := 'X';             -- reset_n
			uart_external_connection_rxd       : in  std_logic                     := 'X';             -- rxd
			uart_external_connection_txd       : out std_logic                                         -- txd
		);
	end component nios_system;

